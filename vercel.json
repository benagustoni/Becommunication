{
  "framework": null,
  "buildCommand": "echo Build OK",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/devis.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    },
    "api/prestataires.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
